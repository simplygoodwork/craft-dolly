{% extends '_layouts/cp' %}

{#
 # One Import from the Import log: who ran it, when, where the Payload came from, the choices made and the result for
 # each Root element.
 #}

{% set title = 'Import #{id}'|t('dolly', { id: import.id }) %}
{% set crumbs = [
    { label: 'Utilities'|t('app'), url: url('utilities') },
    { label: 'Dolly', url: url('utilities/dolly') },
] %}

{% set user = import.userId ? craft.users.id(import.userId).status(null).one() : null %}
{% set statuses = {
    'created': 'Created a disabled entry'|t('dolly'),
    'overwritten': 'Created a draft on'|t('dolly'),
    'pasted': 'Added blocks to the draft of'|t('dolly'),
    'failed': 'Failed'|t('dolly'),
    'not-imported': 'Not imported yet'|t('dolly'),
} %}
{% set importStatuses = {
    'queued': 'Queued: waiting for the queue to start it.'|t('dolly'),
    'in-progress': 'In progress: {done} of {total} Root elements imported.'|t('dolly', { done: import.results|filter(r => r.status != 'not-imported')|length, total: import.results|length }),
    'completed': 'Completed.'|t('dolly'),
    'failed': 'Failed: nothing more was imported.'|t('dolly'),
} %}

{% block content %}
{% if import.inProgress %}
    {# The queue runs it in the background: show how far it got. #}
    {% do view.registerJs('setTimeout(function() { window.location.reload(); }, 3000);') %}
{% endif %}
<div id="dolly-log-entry">
    <p id="dolly-log-status" class="{{ import.status == 'failed' ? 'error' : (import.inProgress ? 'warning' : 'success') }}" data-status="{{ import.status }}">
        <strong>{{ importStatuses[import.status] ?? import.status }}</strong>
        {% if import.error %}{{ import.error }}{% endif %}
    </p>
    <dl class="meta">
        <dt>{{ 'Imported by'|t('dolly') }}</dt>
        <dd>{{ user ? user.name : 'A user that no longer exists'|t('dolly') }}</dd>
        <dt>{{ 'Imported on'|t('dolly') }}</dt>
        <dd>{{ import.dateCreated|datetime('short') }}</dd>
        <dt>{{ 'Exported from'|t('dolly') }}</dt>
        <dd>{{ import.source.siteUrl ?? 'an unknown site'|t('dolly') }} ({{ import.source.environment ?? 'unknown environment'|t('dolly') }})</dd>
        <dt>{{ 'Exported by'|t('dolly') }}</dt>
        <dd>{{ import.source.exportedBy ?? 'an unknown user'|t('dolly') }}, {{ import.source.exportedAt ?? 'at an unknown time'|t('dolly') }}</dd>
        <dt>{{ 'Payload identity'|t('dolly') }}</dt>
        <dd><code>{{ import.payloadIdentity }}</code></dd>
    </dl>

    {% if import.choices %}
        <h2>{{ 'Choices for Unresolved references'|t('dolly') }}</h2>
        <ul class="bullets">
            {% for choice in import.choices %}
                {% set name = (choice.title is not null ? '"' ~ choice.title ~ '"' : choice.uid) ~ (choice.elementType ? ' (' ~ choice.elementType ~ ')' : '') %}
                <li>
                    {% if choice.choice == 'replace' %}
                        {{ '{name}: replaced with {replacement}'|t('dolly', { name: name, replacement: choice.replacementTitle ?? ('#' ~ choice.replacementId) }) }}
                    {% else %}
                        {{ '{name}: {outcome}'|t('dolly', { name: name, outcome: outcomes[choice.choice] ?? outcomes.skip }) }}
                    {% endif %}
                    {% if choice.filename ?? null %}
                        {{ '(file {filename})'|t('dolly', { filename: choice.filename }) }}
                    {% endif %}
                    {% if choice.location ?? null %}
                        {{ 'Saved in {location}.'|t('dolly', { location: choice.location }) }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2>{{ 'Results'|t('dolly') }}</h2>
    {% for result in import.results %}
        {% set entry = result.elementId ? craft.entries.id(result.elementId).status(null).site('*').unique().one() : null %}
        {% set draft = result.draftId ?? null ? craft.entries.draftId(result.draftId).status(null).site('*').unique().one() : null %}
        {% set name = result.title ?? result.sourceUid %}
        <div class="pane">
            <p>
                <strong>{{ statuses[result.status] ?? result.status }}</strong>:
                {% if draft %}
                    <a href="{{ draft.cpEditUrl }}">{{ draft.title ?? entry.title ?? name }}</a>
                {% elseif entry %}
                    <a href="{{ entry.cpEditUrl }}">{{ entry.title ?? name }}</a>
                {% else %}
                    {{ name }}
                {% endif %}
            </p>
            {% set section = result.section ?? null ? craft.app.entries.getSectionByUid(result.section) : null %}
            {% if result.status != 'pasted' %}
            <p class="light">
                {{ (result.mode ?? 'create') == 'overwrite' ? 'Overwrite'|t('dolly') : 'Create new'|t('dolly') }}{% if section %}, {{ 'in the "{section}" section'|t('dolly', { section: section.name }) }}{% endif %}
            </p>
            {% endif %}
            {% if result.errors ?? [] or result.stubs ?? [] or result.fetchedAssets ?? [] %}
                <ul class="bullets">
                    {% for error in result.errors ?? [] %}
                        <li class="error">{{ error }}</li>
                    {% endfor %}
                    {% for stub in result.stubs ?? [] %}
                        <li>{{ 'Created a disabled Stub for {name}.'|t('dolly', { name: stub.title is not null ? '"' ~ stub.title ~ '"' : stub.uid }) }}</li>
                    {% endfor %}
                    {% for asset in result.fetchedAssets ?? [] %}
                        {% set assetName = asset.title is not null ? '"' ~ asset.title ~ '"' : asset.uid %}
                        <li>{{ (asset.uploaded ?? false) ? 'Created the asset {name} from an uploaded file.'|t('dolly', { name: assetName }) : 'Fetched the asset {name} from its source URL.'|t('dolly', { name: assetName }) }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% include 'dolly/_root-details' with {
                warnings: result.warnings ?? [],
                unresolvedReferences: result.unresolvedReferences ?? [],
                incompleteFields: result.incompleteFields ?? [],
            } only %}
        </div>
    {% endfor %}
</div>
{% endblock %}
