{#
 # The Preview's table of Schema references and their Drift. Shared by the utility's Preview and the Preview in the
 # paste modal.
 #}

{% set drift = plan.drift.all() %}
{% if drift %}
    <h2>{{ 'Schema'|t('dolly') }}</h2>
    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Kind'|t('dolly') }}</th>
                <th>{{ 'Name'|t('dolly') }}</th>
                <th>{{ 'State'|t('dolly') }}</th>
                <th>{{ 'What happens'|t('dolly') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for item in drift %}
                <tr>
                    <td>{{ driftKinds[item.kind] ?? item.kind }}</td>
                    <td>{{ item.name }}</td>
                    <td>{{ driftStates[item.state] ?? item.state }}</td>
                    <td>{{ item.outcome() }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
