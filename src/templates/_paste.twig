{#
 # The Preview in the "Paste from another environment" modal: a rendering of the ImportPlan from the core service for
 # blocks pasted into a field. It decides nothing. The Related elements and Schema tables, and the choices in them, are
 # the utility Preview's.
 #}

{% set driftStates = {
    'matched': 'Matched'|t('dolly'),
    'drifted': 'Drifted'|t('dolly'),
    'type-changed': 'Type changed'|t('dolly'),
    'missing': 'Missing'|t('dolly'),
} %}

<div id="dolly-paste-preview">
    {{ hiddenInput('payload', payload) }}
    {{ hiddenInput('previewed', previewed) }}

    {% if plan.isRefused() %}
        <p class="error" id="dolly-refusal">{{ plan.refusal }}</p>
        <div class="buttons">
            <button type="button" class="btn" data-dolly-back>{{ 'Back'|t('dolly') }}</button>
            <button type="button" class="btn" data-dolly-cancel>{{ 'Cancel'|t('dolly') }}</button>
        </div>
    {% else %}
        <p>{{ 'Nothing has been pasted yet. The blocks will be added to the end of the field {field} in your draft of this entry. Check what will happen, change what you like, then paste.'|t('dolly', { field: '“' ~ target.field.name ~ '”' }) }}</p>

        {% if choiceError %}
            <p class="error" id="dolly-choice-error">{{ choiceError }}</p>
        {% endif %}

        {% if plan.source %}
            <p class="light">
                {{ 'Copied from {siteUrl} ({environment}) by {user} on {date}.'|t('dolly', {
                    siteUrl: plan.source.siteUrl ?? 'an unknown site'|t('dolly'),
                    environment: plan.source.environment ?? 'unknown environment'|t('dolly'),
                    user: plan.source.exportedBy ?? 'an unknown user'|t('dolly'),
                    date: plan.source.exportedAt ?? 'an unknown date'|t('dolly'),
                }) }}
            </p>
        {% endif %}

        {% for warning in plan.warnings %}
            <p class="warning">{{ warning }}</p>
        {% endfor %}

        <h2>{{ 'Blocks'|t('dolly') }}</h2>
        {% for root in plan.roots %}
            <div class="pane">
                {% set name = root.title is not null ? '"' ~ root.title ~ '"' : root.sourceUid %}
                {% if root.isBlocked() %}
                    <p class="error">{{ '{name} can’t be pasted: {reason}'|t('dolly', { name: name, reason: root.blockedBy }) }}</p>
                {% else %}
                    <p>{{ '{name} will be added to the field {field}.'|t('dolly', { name: name, field: '"' ~ target.field.name ~ '"' }) }}</p>
                {% endif %}

                {% include 'dolly/_root-details' with {
                    warnings: root.warnings,
                    unresolvedReferences: root.unresolvedReferences,
                    incompleteFields: root.incompleteFields,
                } only %}
            </div>
        {% endfor %}

        {% include 'dolly/_references' with {
            plan: plan,
            requested: requested,
            choiceLabels: choiceLabels,
            pickers: pickers,
            volumes: volumes,
        } only %}

        {% include 'dolly/_drift' with {
            plan: plan,
            driftKinds: driftKinds,
            driftStates: driftStates,
        } only %}

        <div class="buttons">
            <button type="button" id="dolly-update" class="btn" data-dolly-update>{{ 'Update Preview'|t('dolly') }}</button>
            {% if plan.hasImportableRoots() %}
                <button type="submit" class="btn submit">{{ 'Paste'|t('dolly') }}</button>
            {% endif %}
            <button type="button" class="btn" data-dolly-cancel>{{ 'Cancel'|t('dolly') }}</button>
        </div>
        {% if not plan.hasImportableRoots() %}
            <p class="error">{{ 'None of the blocks can be pasted.'|t('dolly') }}</p>
        {% endif %}
    {% endif %}
</div>
