{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{#
 # The Preview of an Import: a rendering of the ImportPlan from the core service. It decides nothing.
 #}

{% set title = 'Dolly Preview'|t('dolly') %}
{% set crumbs = [
    { label: 'Utilities'|t('app'), url: url('utilities') },
    { label: 'Dolly', url: url('utilities/dolly') },
] %}

{% set driftStates = {
    'matched': 'Matched'|t('dolly'),
    'drifted': 'Drifted'|t('dolly'),
    'type-changed': 'Type changed'|t('dolly'),
    'missing': 'Missing'|t('dolly'),
} %}

{% block content %}
<div id="dolly-preview">
    {% if plan.isRefused() %}
        <p class="error">{{ plan.refusal }}</p>
    {% else %}
        <p>{{ 'Nothing has been imported yet. Check what will happen, change what you like, then import.'|t('dolly') }}</p>

        {% if choiceError %}
            <p class="error" id="dolly-choice-error">{{ choiceError }}</p>
        {% endif %}

        {% if plan.source %}
            <p class="light">
                {{ 'Exported from {siteUrl} ({environment}) by {user} on {date}.'|t('dolly', {
                    siteUrl: plan.source.siteUrl ?? 'an unknown site'|t('dolly'),
                    environment: plan.source.environment ?? 'unknown environment'|t('dolly'),
                    user: plan.source.exportedBy ?? 'an unknown user'|t('dolly'),
                    date: plan.source.exportedAt ?? 'an unknown date'|t('dolly'),
                }) }}
            </p>
        {% endif %}

        {% for warning in plan.warnings %}
            <p class="warning">{{ warning }}</p>
        {% endfor %}

        <form id="dolly-import" method="post" enctype="multipart/form-data" accept-charset="UTF-8">
        {{ actionInput('dolly/import/import') }}
        {{ csrfInput() }}
        {{ hiddenInput('payload', payload) }}
        {{ hiddenInput('previewed', previewed) }}

        <h2>{{ 'Entries'|t('dolly') }}</h2>
        {% for root in plan.roots %}
            <div class="pane">
                {% set name = root.title is not null ? '"' ~ root.title ~ '"' : root.sourceUid %}
                {% if root.isBlocked() %}
                    <p class="error">{{ '{name} can’t be imported: {reason}'|t('dolly', { name: name, reason: root.blockedBy }) }}</p>
                {% elseif root.mode == 'overwrite' %}
                    <p>{{ 'A draft will be created on {entry} with the Payload’s content.'|t('dolly', { entry: '"' ~ root.overwrite.canonical.title ~ '"' }) }}</p>
                {% else %}
                    <p>{{ '{name} will be created as a disabled entry in the "{section}" section.'|t('dolly', { name: name, section: root.section.name }) }}</p>
                {% endif %}

                {% if not root.isBlocked() and root.match and root.mode == 'create' %}
                    <p class="light">{{ 'It matches an existing entry, which will be left alone.'|t('dolly') }}</p>
                {% endif %}

                {% if root.sourceUid and root.availableSections %}
                    {% set requestedSection = requestedRoots[root.sourceUid].section ?? root.section.uid ?? '' %}
                    {% if root.availableSections|length > 1 or root.isBlocked() %}
                        <div class="field">
                            <div class="heading"><label>{{ 'Section'|t('dolly') }}</label></div>
                            <div class="select">
                                <select name="rootChoices[{{ root.sourceUid }}][section]" data-dolly-section data-dolly-replan>
                                    {% if not root.section %}<option value="">{{ 'Choose a section'|t('dolly') }}</option>{% endif %}
                                    {% for section in root.availableSections %}
                                        <option value="{{ section.uid }}"{{ section.uid == requestedSection ? ' selected' }}>{{ section.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    {% endif %}
                {% endif %}
                {% if root.sourceUid and 'overwrite' in root.availableModes %}
                    <div class="field">
                        <div class="heading"><label>{{ 'What to do with the matching entry'|t('dolly') }}</label></div>
                        <div class="select">
                            <select name="rootChoices[{{ root.sourceUid }}][mode]" data-dolly-mode data-dolly-replan>
                                <option value="create"{{ root.mode == 'create' ? ' selected' }}>{{ 'Create a new entry'|t('dolly') }}</option>
                                <option value="overwrite"{{ root.mode == 'overwrite' ? ' selected' }}>{{ 'Overwrite it (on a draft)'|t('dolly') }}</option>
                            </select>
                        </div>
                    </div>
                {% endif %}
                {% if root.match and root.overwriteUnavailable %}
                    <p class="light">{{ root.overwriteUnavailable }}</p>
                {% endif %}

                {% include 'dolly/_root-details' with {
                    warnings: root.warnings,
                    unresolvedReferences: root.unresolvedReferences,
                    incompleteFields: root.incompleteFields,
                } only %}
            </div>
        {% endfor %}

        {% include 'dolly/_references' with {
            plan: plan,
            requested: requested,
            choiceLabels: choiceLabels,
            pickers: pickers,
            volumes: volumes,
        } only %}

        {% include 'dolly/_drift' with {
            plan: plan,
            driftKinds: driftKinds,
            driftStates: driftStates,
        } only %}

        <div class="buttons">
            <button type="submit" id="dolly-update" class="btn" name="action" value="dolly/import/preview">{{ 'Update Preview'|t('dolly') }}</button>
            {% if plan.hasImportableRoots() %}
                <button type="submit" class="btn submit" name="action" value="dolly/import/import">{{ 'Import'|t('dolly') }}</button>
            {% endif %}
        </div>
        {% if not plan.hasImportableRoots() %}
            <p class="error">{{ 'None of the entries can be imported.'|t('dolly') }}</p>
        {% endif %}
        </form>
    {% endif %}
</div>

{% if not plan.isRefused() %}
{% do view.registerAssetBundle('simplygoodwork\\craftdolly\\web\\assets\\preview\\PreviewAsset') %}
{% js %}{% verbatim %}
(function() {
    var form = document.getElementById('dolly-import');
    if (!form) { return; }
    var update = document.getElementById('dolly-update');
    Dolly.bindPreview(form, function() { form.requestSubmit(update); });
})();
{% endverbatim %}{% endjs %}
{% endif %}

{% if plan.envelope %}
    <details>
        <summary>{{ 'View as JSON'|t('dolly') }}</summary>
        <pre id="dolly-json" class="code">{{ plan.envelope|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
    </details>
{% endif %}
{% endblock %}
