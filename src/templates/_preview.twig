{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{#
 # The Preview of an Import: a rendering of the ImportPlan from the core service. It decides nothing.
 #}

{% set title = 'Portage Preview'|t('portage') %}
{% set crumbs = [
    { label: 'Utilities'|t('app'), url: url('utilities') },
    { label: 'Portage', url: url('utilities/portage') },
] %}

{% set driftStates = {
    'matched': 'Matched'|t('portage'),
    'drifted': 'Drifted'|t('portage'),
    'type-changed': 'Type changed'|t('portage'),
    'missing': 'Missing'|t('portage'),
} %}

{% block content %}
<div id="portage-preview">
    {% if plan.isRefused() %}
        <p class="error">{{ plan.refusal }}</p>
    {% else %}
        <p>{{ 'Nothing has been imported yet. Check what will happen, change what you like, then import.'|t('portage') }}</p>

        {% if choiceError %}
            <p class="error" id="portage-choice-error">{{ choiceError }}</p>
        {% endif %}

        {% if plan.source %}
            <p class="light">
                {{ 'Exported from {siteUrl} ({environment}) by {user} on {date}.'|t('portage', {
                    siteUrl: plan.source.siteUrl ?? 'an unknown site'|t('portage'),
                    environment: plan.source.environment ?? 'unknown environment'|t('portage'),
                    user: plan.source.exportedBy ?? 'an unknown user'|t('portage'),
                    date: plan.source.exportedAt ?? 'an unknown date'|t('portage'),
                }) }}
            </p>
        {% endif %}

        {% for warning in plan.warnings %}
            <p class="warning">{{ warning }}</p>
        {% endfor %}

        <form id="portage-import" method="post" enctype="multipart/form-data" accept-charset="UTF-8">
        {{ actionInput('portage/import/import') }}
        {{ csrfInput() }}
        {{ hiddenInput('payload', payload) }}
        {{ hiddenInput('previewed', previewed) }}

        <h2>{{ 'Entries'|t('portage') }}</h2>
        {% for root in plan.roots %}
            <div class="pane">
                {% set name = root.title is not null ? '"' ~ root.title ~ '"' : root.sourceUid %}
                {% if root.isBlocked() %}
                    <p class="error">{{ '{name} can’t be imported: {reason}'|t('portage', { name: name, reason: root.blockedBy }) }}</p>
                {% elseif root.mode == 'overwrite' %}
                    <p>{{ 'A draft will be created on {entry} with the Payload’s content.'|t('portage', { entry: '"' ~ root.overwrite.canonical.title ~ '"' }) }}</p>
                {% else %}
                    <p>{{ '{name} will be created as a disabled entry in the "{section}" section.'|t('portage', { name: name, section: root.section.name }) }}</p>
                {% endif %}

                {% if not root.isBlocked() and root.match and root.mode == 'create' %}
                    <p class="light">{{ 'It matches an existing entry, which will be left alone.'|t('portage') }}</p>
                {% endif %}

                {% if root.sourceUid and root.availableSections %}
                    {% set requestedSection = requestedRoots[root.sourceUid].section ?? root.section.uid ?? '' %}
                    {% if root.availableSections|length > 1 or root.isBlocked() %}
                        <div class="field">
                            <div class="heading"><label>{{ 'Section'|t('portage') }}</label></div>
                            <div class="select">
                                <select name="rootChoices[{{ root.sourceUid }}][section]" data-portage-section data-portage-replan>
                                    {% if not root.section %}<option value="">{{ 'Choose a section'|t('portage') }}</option>{% endif %}
                                    {% for section in root.availableSections %}
                                        <option value="{{ section.uid }}"{{ section.uid == requestedSection ? ' selected' }}>{{ section.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    {% endif %}
                {% endif %}
                {% if root.sourceUid and 'overwrite' in root.availableModes %}
                    <div class="field">
                        <div class="heading"><label>{{ 'What to do with the matching entry'|t('portage') }}</label></div>
                        <div class="select">
                            <select name="rootChoices[{{ root.sourceUid }}][mode]" data-portage-mode data-portage-replan>
                                <option value="create"{{ root.mode == 'create' ? ' selected' }}>{{ 'Create a new entry'|t('portage') }}</option>
                                <option value="overwrite"{{ root.mode == 'overwrite' ? ' selected' }}>{{ 'Overwrite it (on a draft)'|t('portage') }}</option>
                            </select>
                        </div>
                    </div>
                {% endif %}
                {% if root.match and root.overwriteUnavailable %}
                    <p class="light">{{ root.overwriteUnavailable }}</p>
                {% endif %}

                {% include 'portage/_root-details' with {
                    warnings: root.warnings,
                    unresolvedReferences: root.unresolvedReferences,
                    incompleteFields: root.incompleteFields,
                } only %}
            </div>
        {% endfor %}

        {% if plan.references %}
            <h2>{{ 'Related elements'|t('portage') }}</h2>
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Element'|t('portage') }}</th>
                        <th>{{ 'Type'|t('portage') }}</th>
                        <th>{{ 'In this environment'|t('portage') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for uid, reference in plan.references %}
                        {% set unresolved = not reference.resolution.isResolved() %}
                        {% set want = requested[uid] ?? null %}
                        {% set selected = reference.pending ?? want.choice ?? reference.choice %}
                        <tr data-portage-reference="{{ uid }}">
                            <td>{{ reference.name() }}</td>
                            <td>{{ reference.elementType|capitalize }}</td>
                            <td>
                                <div class="portage-outcome">{{ reference.outcome() }}</div>
                                {% if unresolved %}
                                    <div class="select">
                                        <select name="choices[{{ uid }}][choice]" aria-label="{{ 'What to do with {name}'|t('portage', { name: reference.name() }) }}" data-portage-choice data-portage-replan>
                                            {% for choice in reference.availableChoices %}
                                                <option value="{{ choice }}"{{ choice == selected ? ' selected' }}>{{ choiceLabels[choice] ?? choice }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    {% if 'replace' in reference.availableChoices and pickers[uid] is defined %}
                                        {% set picked = reference.replacement ? [reference.replacement] : [] %}
                                        <div data-panel="replace"{{ selected != 'replace' ? ' class="hidden"' }}>
                                            {{ forms.elementSelect({
                                                id: 'portage-replacement-' ~ loop.index,
                                                name: 'choices[' ~ uid ~ '][replacement]',
                                                elementType: pickers[uid].elementType,
                                                sources: pickers[uid].sources,
                                                elements: picked,
                                                limit: 1,
                                            }) }}
                                            {% if reference.pending == 'replace' %}
                                                <p class="light">{{ 'Pick a replacement. Until you do, this will be skipped.'|t('portage') }}</p>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    {% if reference.elementType == 'asset' %}
                                        <div data-panel="fetch upload"{{ selected not in ['fetch', 'upload'] ? ' class="hidden"' }}>
                                            <div class="field">
                                                <div class="heading"><label>{{ 'Save it in the volume'|t('portage') }}</label></div>
                                                <div class="select">
                                                    <select name="choices[{{ uid }}][volume]" data-portage-replan>
                                                        <option value="">{{ 'Its own volume'|t('portage') }}</option>
                                                        {% for volume in volumes %}
                                                            <option value="{{ volume.uid }}"{{ volume.uid == want.volume ?? '' ? ' selected' }}>{{ volume.name }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <input type="text" class="text" name="choices[{{ uid }}][folder]" value="{{ want.folder ?? '' }}" placeholder="{{ 'Folder path (when you choose a volume)'|t('portage') }}" data-portage-replan>
                                            </div>
                                        </div>
                                        <div data-panel="fetch"{{ selected != 'fetch' ? ' class="hidden"' }}>
                                            <p class="light">{{ 'Fetching fails for private volumes and for sources behind basic auth. Upload the file instead.'|t('portage') }}</p>
                                        </div>
                                        <div data-panel="upload"{{ selected != 'upload' ? ' class="hidden"' }}>
                                            <input type="file" name="uploads[{{ uid }}]" data-portage-replan>
                                            {{ hiddenInput('choices[' ~ uid ~ '][staged]', want.staged ?? '') }}
                                            {% if want.stagedName ?? '' %}
                                                <p class="light">{{ 'Using the uploaded file {name}. Choose another file to replace it.'|t('portage', { name: want.stagedName }) }}</p>
                                            {% elseif reference.pending == 'upload' %}
                                                <p class="light">{{ 'Choose a file. Until you do, this will be skipped.'|t('portage') }}</p>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% set drift = plan.drift.all() %}
        {% if drift %}
            <h2>{{ 'Schema'|t('portage') }}</h2>
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Kind'|t('portage') }}</th>
                        <th>{{ 'Name'|t('portage') }}</th>
                        <th>{{ 'State'|t('portage') }}</th>
                        <th>{{ 'What happens'|t('portage') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in drift %}
                        <tr>
                            <td>{{ driftKinds[item.kind] ?? item.kind }}</td>
                            <td>{{ item.name }}</td>
                            <td>{{ driftStates[item.state] ?? item.state }}</td>
                            <td>{{ item.outcome() }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <div class="buttons">
            <button type="submit" id="portage-update" class="btn" name="action" value="portage/import/preview">{{ 'Update Preview'|t('portage') }}</button>
            {% if plan.hasImportableRoots() %}
                <button type="submit" class="btn submit" name="action" value="portage/import/import">{{ 'Import'|t('portage') }}</button>
            {% endif %}
        </div>
        {% if not plan.hasImportableRoots() %}
            <p class="error">{{ 'None of the entries can be imported.'|t('portage') }}</p>
        {% endif %}
        </form>
    {% endif %}
</div>

{% if not plan.isRefused() %}
{% js %}{% verbatim %}
(function() {
    var form = document.getElementById('portage-import');
    if (!form) { return; }
    var update = document.getElementById('portage-update');
    var importButton = form.querySelector('button.submit');
    var replanning = false;
    var timer = null;
    // The Import button stays off from the moment a choice changes until the Preview has been rebuilt, so the Import
    // can't run choices the Preview hasn't shown.
    function replan() {
        if (replanning) { return; }
        replanning = true;
        clearTimeout(timer);
        form.requestSubmit(update);
    }
    function pending() {
        if (importButton) { importButton.disabled = true; }
    }
    form.addEventListener('input', function(event) {
        if (event.target.matches('input[type="text"][data-portage-replan]')) {
            pending();
            clearTimeout(timer);
            timer = setTimeout(replan, 600);
        }
    });
    form.addEventListener('change', function(event) {
        var target = event.target;
        if (!target.matches('[data-portage-replan]')) { return; }
        pending();
        if (target.matches('[data-portage-choice]')) {
            var row = target.closest('[data-portage-reference]');
            row.querySelectorAll('[data-panel]').forEach(function(panel) {
                panel.classList.toggle('hidden', panel.getAttribute('data-panel').split(' ').indexOf(target.value) === -1);
            });
        }
        if (target.matches('[data-portage-section]')) {
            // The matching entry depends on the section, so go back to creating a new entry.
            var mode = target.closest('.pane').querySelector('[data-portage-mode]');
            if (mode) { mode.value = 'create'; }
        }
        replan();
    });
    // Craft's element selector adds and removes hidden inputs rather than firing a change event.
    form.querySelectorAll('[data-portage-reference] .elementselect').forEach(function(picker) {
        var count = function() { return picker.querySelectorAll('input[type="hidden"][name$="[replacement][]"]').length; };
        var before = count();
        new MutationObserver(function() {
            if (count() !== before) { before = count(); pending(); replan(); }
        }).observe(picker, { childList: true, subtree: true });
    });
})();
{% endverbatim %}{% endjs %}
{% endif %}

{% if plan.envelope %}
    <details>
        <summary>{{ 'View as JSON'|t('portage') }}</summary>
        <pre id="portage-json" class="code">{{ plan.envelope|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
    </details>
{% endif %}
{% endblock %}
