{
  "name": "simplygoodwork/craft-portage",
  "description": "Easily port content from one environment to another.",
  "type": "craft-plugin",
  "license": "proprietary",
  "support": {
    "email": "dev@simplygoodwork.com",
    "issues": "https://github.com/simplygoodwork/craft-portage/issues?state=open",
    "source": "https://github.com/simplygoodwork/craft-portage",
    "docs": "https://github.com/simplygoodwork/craft-portage",
    "rss": "https://github.com/simplygoodwork/craft-portage/releases.atom"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.10.0"
  },
  "require-dev": {
    "codeception/codeception": "^5.1",
    "codeception/module-asserts": "^3.0",
    "codeception/module-yii2": "^1.1",
    "craftcms/ckeditor": "^5.9",
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "craftpulse/craft-colour-swatches": "^5.0",
    "ether/seo": "^5.0",
    "ether/simplemap": "^5.0",
    "jalendport/craft-preparse": "^3.0@alpha",
    "lewisjenkins/craft-dynamic-fields": "^5.0",
    "nystudio107/craft-code-field": "^5.0",
    "nystudio107/craft-retour": "^5.0",
    "nystudio107/craft-seomatic": "^5.1",
    "phpstan/phpstan": "^2.1",
    "presseddigital/linkit": "^5.0",
    "rias/craft-position-fieldtype": "^5.0",
    "solspace/craft-calendar": "^5.0",
    "spicyweb/craft-neo": "^5.0",
    "verbb/formie": "^3.0 || ^4.0",
    "verbb/hyper": "^2.0",
    "verbb/tablemaker": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "simplygoodwork\\craftportage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "simplygoodwork\\craftportage\\tests\\support\\": "tests/_support/"
    }
  },
  "extra": {
    "handle": "portage",
    "name": "Portage",
    "developer": "Good Work",
    "documentationUrl": "https://github.com/simplygoodwork/craft-portage"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "codecept run",
    "check": [
      "@phpstan",
      "@check-cs",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
